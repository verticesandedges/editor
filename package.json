{
  "name": "editor",
  "version": "0.52.0",
  "description": "A canvas based graph app",
  "keywords": [
    "interactive",
    "force-directed",
    "3D",
    "graph",
    "editor"
  ],
  "homepage": "https://github.com/verticesandedges/editor#readme",
  "bugs": {
    "url": "https://github.com/verticesandedges/editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/verticesandedges/editor.git"
  },
  "license": "UNLICENSED",
  "author": "Joshua M. Moore <joshua.moore@verticesandedges.net>",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "parcel src/index.html --dist-dir docs/",
    "build": "parcel build src/index.html --dist-dir docs/",
    "build:github": "parcel build src/index.html --dist-dir docs/ --public-url /editor/",
    "commit": "git add . && git commit -m \"Rebuild $(date '+%Y-%m-%d %H:%M:%S')\"",
    "start": "http-server docs/ -c-1 --silent && echo http://localhost:8080/",
    "clean": "rm -rf .parcel-cache/ docs/"
  },
  "source": "src/index.html",
  "targets": {
    "main": false,
    "default": {
      "distDir": "./docs/"
    }
  },
  "pluginOptions": {
    "staticFiles": {
      "staticPath": [
        {
          "src": "static",
          "outDir": "."
        }
      ]
    }
  },
  "devDependencies": {
    "parcel": "^2.16.4",
    "process": "^0.11.10"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "invokers": "^2.2.0",
    "katex": "^0.19.1"
  }
}
